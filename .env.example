# Copy to .env for local overrides, or set these in your deployment
# environment. No secrets are required to run this site.

# --- Runtime (read by adapter-node inside the container) ---------------------

# Interface and port the Node server binds to. 0.0.0.0 is required in Docker.
HOST=0.0.0.0
PORT=3000

# Public origin of the site. Must match what the reverse proxy serves.
ORIGIN=https://ro6one.com

# Trust the reverse proxy's forwarding headers (already set in compose.yml).
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# --- Compose (host side) -----------------------------------------------------

# Where the container port is published on the host. Keep it on localhost and
# let the reverse proxy terminate TLS on 80/443.
HOST_BIND=127.0.0.1
HOST_PORT=3000

# --- Application -------------------------------------------------------------

# Used for canonical links and Open Graph URLs. Falls back to the value in
# src/lib/content/site.ts when unset.
PUBLIC_SITE_URL=https://ro6one.com
